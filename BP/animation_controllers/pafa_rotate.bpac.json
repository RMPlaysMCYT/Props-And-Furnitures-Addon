{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.pafa.furniture_rotate":{
            "initial_state": "default",
            "states": {
                "default":{
                    "transitions": [
                        {
                            "default": "query.is_saddled == 1"
                        }
                    ]
                },
                "rotate":{
                    "animations": [
                        "furniture_rotate"
                    ],
                    "transitions": [
                        {
                            "default": "query.is_saddled == 0"
                        }
                    ]
                }
            }
        }
    }
}